# Downloadable source dependencies stay in the build cache, never in the source package.
include(FetchContent)
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/dependencies.lock.json" voyemu_lock)
string(JSON voyemu_schema GET "${voyemu_lock}" schema)
if(NOT voyemu_schema EQUAL 1)
    message(FATAL_ERROR "Unsupported native dependency lock schema")
endif()
set(VOYEMU_VENDOR_ROOT "${CMAKE_CURRENT_BINARY_DIR}/vendor")
get_filename_component(voyemu_dependency_root "${CMAKE_CURRENT_SOURCE_DIR}/../.." REALPATH)
string(JSON voyemu_count LENGTH "${voyemu_lock}" dependencies)
math(EXPR voyemu_last "${voyemu_count}-1")
foreach(index RANGE ${voyemu_last})
    string(JSON dependency GET "${voyemu_lock}" dependencies ${index} name)
    if(NOT dependency MATCHES "^[a-z][a-z0-9_-]*$")
        message(FATAL_ERROR "Unsafe native dependency name")
    endif()
    string(JSON file_count LENGTH "${voyemu_lock}" dependencies ${index} files)
    math(EXPR last_file "${file_count}-1")
    foreach(file_index RANGE ${last_file})
        string(JSON file GET "${voyemu_lock}" dependencies ${index} files ${file_index} file)
        string(JSON expected GET "${voyemu_lock}" dependencies ${index} files ${file_index} sha256)
        if(IS_ABSOLUTE "${file}" OR file MATCHES "(^|/)\\.\\.(/|$)" OR file MATCHES "\\\\")
            message(FATAL_ERROR "Unsafe native dependency file")
        endif()
        set(source "${VOYEMU_VENDOR_ROOT}/${dependency}/${file}")
        if(NOT EXISTS "${source}")
            # Older local checkouts may already have the exact files; use them as an offline cache only.
            set(cached "${CMAKE_CURRENT_SOURCE_DIR}/vendor/${dependency}/${file}")
            if(EXISTS "${cached}" AND NOT IS_SYMLINK "${cached}")
                file(SHA256 "${cached}" actual)
                if(NOT actual STREQUAL expected)
                    message(FATAL_ERROR "Cached dependency pin mismatch: ${dependency}/${file}")
                endif()
            else()
                string(JSON url GET "${voyemu_lock}" dependencies ${index} url)
                string(JSON archive_sha GET "${voyemu_lock}" dependencies ${index} archive_sha256)
                # The offline cache keeps the upstream archive suffix: FetchContent picks the extractor from it.
                string(REGEX MATCH "\\.(tar\\.gz|tar\\.xz|zip)$" archive_suffix "${url}")
                if(NOT archive_suffix)
                    message(FATAL_ERROR "Unsupported native dependency archive: ${dependency}")
                endif()
                set(archive "${voyemu_dependency_root}/.local/toolchains/downloads/sources/${archive_sha}${archive_suffix}")
                if(EXISTS "${archive}")
                    set(url "${archive}")
                endif()
                FetchContent_Declare(voyemu_source_${dependency} URL "${url}" URL_HASH "SHA256=${archive_sha}")
                FetchContent_GetProperties(voyemu_source_${dependency})
                if(NOT voyemu_source_${dependency}_POPULATED)
                    FetchContent_Populate(voyemu_source_${dependency})
                endif()
                string(JSON upstream ERROR_VARIABLE no_mapping GET "${voyemu_lock}" dependencies ${index} files ${file_index} upstream_file)
                if(no_mapping)
                    set(upstream "${file}")
                endif()
                set(cached "${voyemu_source_${dependency}_SOURCE_DIR}/${upstream}")
            endif()
            if(IS_SYMLINK "${cached}" OR NOT EXISTS "${cached}")
                message(FATAL_ERROR "Missing upstream source: ${dependency}/${file}")
            endif()
            file(SHA256 "${cached}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Upstream dependency pin mismatch: ${dependency}/${file}")
            endif()
            get_filename_component(parent "${source}" DIRECTORY)
            file(MAKE_DIRECTORY "${parent}")
            configure_file("${cached}" "${source}" COPYONLY)
        endif()
        if(IS_SYMLINK "${source}")
            message(FATAL_ERROR "Linked build dependency: ${dependency}/${file}")
        endif()
        file(SHA256 "${source}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Native dependency pin mismatch: ${dependency}/${file}")
        endif()
    endforeach()
endforeach()
