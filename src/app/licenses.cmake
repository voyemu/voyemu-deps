foreach(pair IN ITEMS "ImGui.txt|173506a2d6f7fb67990d257fb2507f188690eca39060c39469ae7bef43aae2a3" "nlohmann-json.txt|46a65cffd1ea955132d95a8dd921640714a8d6b537d2e4e482d31145ae95b603" "SDL3.txt|1c040b8271b37e5076359f8fd54240e371114112924d2df81ef87c7d6a1dfdfd" "libarchive.txt|30e556b3959e3985d66efefec5eaac51d4995053caa1d3cffe6eb916f146f229" "lzokay.txt|28933aedd9381e87e1fabb4491b00dfddd4f24ecac6adb7988fa1df7cf296813")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 name)
    list(GET fields 1 expected)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/../licenses/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Embedded notice differs from pinned dependency: ${name}")
    endif()
endforeach()
# Embed full notices from checked-in or SHA-verified dependency sources.
set(voyemu_license_data "static constexpr LicenseNotice license_entries[]={\n")
function(voyemu_license component authors license url path)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    file(READ "${path}" text)
    foreach(extra IN LISTS ARGN)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${extra}")
        file(READ "${extra}" extra_text)
        string(APPEND text "\n\n${extra_text}")
    endforeach()
    # The miniz LICENSE has CRLF line ends; the catalogue keeps LF only.
    string(REPLACE "\r\n" "\n" text "${text}")
    string(FIND "${text}" ")VOYEMU_LICENSE\"" delimiter)
    if(NOT delimiter EQUAL -1)
        message(FATAL_ERROR "License text conflicts with C++ raw string delimiter")
    endif()
    string(APPEND voyemu_license_data "{\"${component}\",\"${authors}\",\"${license}\",\"${url}\",R\"VOYEMU_LICENSE(${text})VOYEMU_LICENSE\"},\n")
    set(voyemu_license_data "${voyemu_license_data}" PARENT_SCOPE)
endfunction()
