# Formats or checks Voyemu C, C++ and Objective-C++ sources with the pinned clang-format, whose
# blank lines Uncrustify (config/config-uncrustify.cfg) sets between two clang-format passes, and
# Java sources with src/dev/format/JavaBlankLines.java and the pinned google-java-format in AOSP style;
# check mode then runs the pinned Checkstyle with config/config-checkstyle.xml on the pinned JDK.
# Usage: cmake -DVOYEMU_FORMAT_MODE=check|fix [-DVOYEMU_CLANG_FORMAT=<path>]
#        [-DVOYEMU_GOOGLE_JAVA_FORMAT=<path>] [-DVOYEMU_FORMAT_DIRECTORY=<directory>]
#        -P src/dev/format/format.cmake
cmake_minimum_required(VERSION 3.22)
get_filename_component(voyemu_root "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
set(voyemu_format_roots src/app src/dev src/guest)
set(voyemu_format_extensions "\\.(c|h|cpp|hpp|mm|inc)$")
set(voyemu_java_format_roots src/prepare src/guest profiles src/app/core/generator src/app/graphics/generator src/dev/checks src/dev/format)
set(voyemu_java_format_extensions "\\.java$")
# Single list of excluded sources: pinned third-party bytes, generated tables and the formatter
# fixtures, whose unformatted inputs format.test.cmake checks.
set(voyemu_format_excluded_prefixes
    src/app/third_party/
    src/dev/format/test/
)
set(voyemu_format_excluded_files
    # Generated by GeneratePassionCatalog.java and GenerateGraphics.java.
    src/app/core/passion_catalog.inc
    src/app/graphics/generated_graphics.inc
    # Generated from the profile MCU catalog.
    src/guest/qnx/mcu_catalog.inc
    src/guest/qnx/native_mcu_layout.inc
)

if(NOT VOYEMU_FORMAT_MODE MATCHES "^(check|fix)$")
    message(FATAL_ERROR "VOYEMU_FORMAT_MODE must be check or fix")
endif()
file(READ "${voyemu_root}/src/app/toolchain.json" voyemu_toolchain_json)
# Resolves a pinned optionalTools formatter unless the caller passed an explicit path.
macro(voyemu_formatter variable key)
    if(NOT ${variable})
        string(JSON directory GET "${voyemu_toolchain_json}" optionalTools ${key} directory)
        string(JSON binary GET "${voyemu_toolchain_json}" optionalTools ${key} binary)
        set(${variable} "${voyemu_root}/${directory}/${binary}")
        if(CMAKE_HOST_WIN32)
            string(APPEND ${variable} ".exe")
        endif()
    endif()
    if(NOT EXISTS "${${variable}}")
        message(FATAL_ERROR "Formatter not found at ${${variable}}; install the optionalTools.${key} pin from src/app/toolchain.json or pass -D${variable}=<path>")
    endif()
endmacro()
voyemu_formatter(VOYEMU_CLANG_FORMAT clangFormat)
voyemu_formatter(VOYEMU_GOOGLE_JAVA_FORMAT googleJavaFormat)
voyemu_formatter(VOYEMU_UNCRUSTIFY uncrustify)
execute_process(COMMAND "${VOYEMU_UNCRUSTIFY}" --version OUTPUT_VARIABLE voyemu_uncrustify_version RESULT_VARIABLE voyemu_result)
if(NOT voyemu_result EQUAL 0 OR NOT voyemu_uncrustify_version MATCHES "Uncrustify-0\\.83\\.0([^0-9]|$)")
    message(FATAL_ERROR "Uncrustify 0.83.0 required, found: ${voyemu_uncrustify_version}; run cmake -P src/dev/format/uncrustify.cmake")
endif()
if(CMAKE_HOST_WIN32)
    set(voyemu_jdk_host windowsBuild)
elseif(CMAKE_HOST_APPLE)
    set(voyemu_jdk_host macosBuild)
else()
    set(voyemu_jdk_host linuxBuild)
endif()
string(JSON voyemu_jdk GET "${voyemu_toolchain_json}" optionalTools ${voyemu_jdk_host} jdk directory)
set(voyemu_java "${voyemu_root}/${voyemu_jdk}")
if(CMAKE_HOST_APPLE)
    # The macOS archive wraps the JDK home in Contents/Home.
    string(APPEND voyemu_java "/Contents/Home")
endif()
string(APPEND voyemu_java "/bin/java")
if(CMAKE_HOST_WIN32)
    string(APPEND voyemu_java ".exe")
endif()
if(NOT EXISTS "${voyemu_java}")
    message(FATAL_ERROR "${voyemu_java} not found; install the optionalTools.${voyemu_jdk_host}.jdk pin from src/app/toolchain.json")
endif()
execute_process(COMMAND "${VOYEMU_CLANG_FORMAT}" --version OUTPUT_VARIABLE voyemu_clang_format_version RESULT_VARIABLE voyemu_result)
if(NOT voyemu_result EQUAL 0 OR NOT voyemu_clang_format_version MATCHES "clang-format version 23\\.1\\.3([^0-9]|$)")
    message(FATAL_ERROR "clang-format 23.1.3 required, found: ${voyemu_clang_format_version}")
endif()
execute_process(COMMAND "${VOYEMU_GOOGLE_JAVA_FORMAT}" --version OUTPUT_VARIABLE voyemu_java_format_version
    ERROR_VARIABLE voyemu_java_format_version RESULT_VARIABLE voyemu_result)
if(NOT voyemu_result EQUAL 0 OR NOT voyemu_java_format_version MATCHES "google-java-format: Version 2\\.0\\.0([^0-9]|$)")
    message(FATAL_ERROR "google-java-format 2.0.0 required, found: ${voyemu_java_format_version}")
endif()

include("${voyemu_root}/src/app/source_files.cmake")
# Sets output to the tracked and new non-ignored files under roots matching the configured filters.
function(voyemu_select_files output extensions)
    voyemu_source_files(tracked "${voyemu_root}" ${ARGN})
    set(files)
    foreach(file IN LISTS tracked)
        if(NOT file MATCHES "${extensions}" OR file IN_LIST voyemu_format_excluded_files)
            continue()
        endif()
        set(excluded FALSE)
        foreach(prefix IN LISTS voyemu_format_excluded_prefixes)
            string(FIND "${file}" "${prefix}" position)
            if(position EQUAL 0)
                set(excluded TRUE)
            endif()
        endforeach()
        if(NOT excluded)
            list(APPEND files "${file}")
        endif()
    endforeach()
    if(NOT files)
        message(FATAL_ERROR "No sources selected for formatting under ${ARGN}")
    endif()
    set(${output} "${files}" PARENT_SCOPE)
endfunction()
# VOYEMU_FORMAT_DIRECTORY selects every matching file of that directory instead of the project
# sources: the formatter test runs its fixtures through the same rules.
if(VOYEMU_FORMAT_DIRECTORY)
    get_filename_component(voyemu_source_root "${VOYEMU_FORMAT_DIRECTORY}" REALPATH)
    file(GLOB_RECURSE voyemu_files RELATIVE "${voyemu_source_root}" "${voyemu_source_root}/*")
    set(voyemu_java_files "${voyemu_files}")
    list(FILTER voyemu_files INCLUDE REGEX "${voyemu_format_extensions}")
    list(FILTER voyemu_java_files INCLUDE REGEX "${voyemu_java_format_extensions}")
else()
    set(voyemu_source_root "${voyemu_root}")
    voyemu_select_files(voyemu_files "${voyemu_format_extensions}" ${voyemu_format_roots})
    voyemu_select_files(voyemu_java_files "${voyemu_java_format_extensions}" ${voyemu_java_format_roots})
endif()
list(LENGTH voyemu_files voyemu_count)
list(LENGTH voyemu_java_files voyemu_java_count)

# Runs a formatter command over files in bounded batches; sets voyemu_failed when any batch fails.
function(voyemu_run_formatter files)
    set(voyemu_failed FALSE PARENT_SCOPE)
    list(LENGTH files count)
    set(batch)
    set(index 0)
    foreach(file IN LISTS files)
        list(APPEND batch "${file}")
        math(EXPR index "${index} + 1")
        list(LENGTH batch size)
        if(size EQUAL 64 OR index EQUAL count)
            execute_process(COMMAND ${ARGN} ${batch} WORKING_DIRECTORY "${voyemu_source_root}" RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                set(voyemu_failed TRUE PARENT_SCOPE)
            endif()
            set(batch)
        endif()
    endforeach()
endfunction()
set(voyemu_clang_format_command "${VOYEMU_CLANG_FORMAT}" "--style=file:${voyemu_root}/config/config-clang-format.yaml")
set(voyemu_java_format_command "${VOYEMU_GOOGLE_JAVA_FORMAT}" --aosp)

function(voyemu_tree_digest output)
    set(digest)
    foreach(file IN LISTS voyemu_files voyemu_java_files)
        file(SHA256 "${voyemu_source_root}/${file}" hash)
        string(APPEND digest "${hash}")
    endforeach()
    set(${output} "${digest}" PARENT_SCOPE)
endfunction()

# Blank lines: Uncrustify between two clang-format passes for C-family sources, a javac-based
# tool before google-java-format for Java.
set(voyemu_uncrustify_command "${VOYEMU_UNCRUSTIFY}" -q -c "${voyemu_root}/config/config-uncrustify.cfg")
set(voyemu_java_blank_lines_command "${voyemu_java}" -Xmx512m "${voyemu_root}/src/dev/format/JavaBlankLines.java")
function(voyemu_uncrustify_language file output)
    if(file MATCHES "\\.c$")
        set(${output} C PARENT_SCOPE)
    elseif(file MATCHES "\\.mm$")
        set(${output} OC+ PARENT_SCOPE)
    else()
        set(${output} CPP PARENT_SCOPE)
    endif()
endfunction()
# Sets voyemu_layout_failed to the files whose clang-format, Uncrustify, clang-format result differs.
function(voyemu_layout_check)
    set(failed)
    foreach(file IN LISTS voyemu_files)
        voyemu_uncrustify_language("${file}" language)
        execute_process(COMMAND ${voyemu_clang_format_command} "${file}"
                        COMMAND ${voyemu_uncrustify_command} -l ${language}
                        COMMAND ${voyemu_clang_format_command} "--assume-filename=${file}"
                        WORKING_DIRECTORY "${voyemu_source_root}" OUTPUT_VARIABLE formatted RESULTS_VARIABLE results)
        file(READ "${voyemu_source_root}/${file}" current)
        if(NOT results MATCHES "^0;0;0$" OR NOT formatted STREQUAL current)
            list(APPEND failed "${file}")
        endif()
    endforeach()
    set(voyemu_layout_failed "${failed}" PARENT_SCOPE)
endfunction()
# Rewrites C-family sources in place with Uncrustify, grouped by language.
function(voyemu_uncrustify_fix)
    foreach(language C CPP OC+)
        set(selected)
        foreach(file IN LISTS voyemu_files)
            voyemu_uncrustify_language("${file}" file_language)
            if(file_language STREQUAL language)
                list(APPEND selected "${file}")
            endif()
        endforeach()
        if(selected)
            voyemu_run_formatter("${selected}" ${voyemu_uncrustify_command} -l ${language} --replace --no-backup)
            if(voyemu_failed)
                message(FATAL_ERROR "Uncrustify failed")
            endif()
        endif()
    endforeach()
endfunction()

if(VOYEMU_FORMAT_MODE STREQUAL "check")
    string(JSON voyemu_checkstyle_directory GET "${voyemu_toolchain_json}" optionalTools checkstyle directory)
    string(JSON voyemu_checkstyle_jar GET "${voyemu_toolchain_json}" optionalTools checkstyle jar)
    set(voyemu_checkstyle "${voyemu_root}/${voyemu_checkstyle_directory}/${voyemu_checkstyle_jar}")
    foreach(voyemu_tool IN ITEMS "${voyemu_java}" "${voyemu_checkstyle}")
        if(NOT EXISTS "${voyemu_tool}")
            message(FATAL_ERROR "${voyemu_tool} not found; install the optionalTools.${voyemu_jdk_host}.jdk and optionalTools.checkstyle pins from src/app/toolchain.json")
        endif()
    endforeach()
    set(voyemu_checkstyle_command "${voyemu_java}" -Xmx1g -jar "${voyemu_checkstyle}" -c "${voyemu_root}/config/config-checkstyle.xml")
    execute_process(COMMAND ${voyemu_checkstyle_command} --version OUTPUT_VARIABLE voyemu_checkstyle_version
        ERROR_VARIABLE voyemu_checkstyle_version RESULT_VARIABLE voyemu_result)
    if(NOT voyemu_result EQUAL 0 OR NOT voyemu_checkstyle_version MATCHES "Checkstyle version: 12\\.3\\.1([^0-9]|$)")
        message(FATAL_ERROR "Checkstyle 12.3.1 required, found: ${voyemu_checkstyle_version}")
    endif()
    voyemu_run_formatter("${voyemu_files}" ${voyemu_clang_format_command} --dry-run --Werror)
    set(voyemu_clang_failed ${voyemu_failed})
    voyemu_layout_check()
    foreach(file IN LISTS voyemu_layout_failed)
        message(STATUS "${file}: blank lines differ from config/config-uncrustify.cfg")
    endforeach()
    if(voyemu_layout_failed)
        set(voyemu_clang_failed TRUE)
    endif()
    voyemu_run_formatter("${voyemu_java_files}" ${voyemu_java_blank_lines_command} --check)
    set(voyemu_java_blank_failed ${voyemu_failed})
    # google-java-format lists every file that would change.
    voyemu_run_formatter("${voyemu_java_files}" ${voyemu_java_format_command} --dry-run --set-exit-if-changed)
    if(voyemu_clang_failed)
        message(SEND_ERROR "Formatting differs from config/config-clang-format.yaml; run the format target")
    endif()
    if(voyemu_failed OR voyemu_java_blank_failed)
        message(SEND_ERROR "Java formatting differs from google-java-format --aosp or src/dev/format/JavaBlankLines.java; run the format target")
    endif()
    if(voyemu_java_blank_failed)
        set(voyemu_failed TRUE)
    endif()
    set(voyemu_java_format_failed ${voyemu_failed})
    # Checkstyle runs on the formatted sources and lists every finding.
    voyemu_run_formatter("${voyemu_java_files}" ${voyemu_checkstyle_command})
    if(voyemu_failed)
        message(SEND_ERROR "Java sources violate config/config-checkstyle.xml; fix the listed findings")
    endif()
    if(voyemu_clang_failed OR voyemu_java_format_failed OR voyemu_failed)
        message(FATAL_ERROR "Formatting check failed")
    endif()
    message(STATUS "Formatting and Checkstyle check passed for ${voyemu_count} C/C++ and ${voyemu_java_count} Java files")
    return()
endif()
# Some constructs settle only on a later pass; repeat until the tree stops changing.
foreach(pass RANGE 1 8)
    voyemu_tree_digest(before)
    voyemu_run_formatter("${voyemu_files}" ${voyemu_clang_format_command} -i)
    if(voyemu_failed)
        message(FATAL_ERROR "clang-format failed")
    endif()
    voyemu_uncrustify_fix()
    voyemu_run_formatter("${voyemu_files}" ${voyemu_clang_format_command} -i)
    if(voyemu_failed)
        message(FATAL_ERROR "clang-format failed")
    endif()
    voyemu_run_formatter("${voyemu_java_files}" ${voyemu_java_blank_lines_command} --fix)
    if(voyemu_failed)
        message(FATAL_ERROR "JavaBlankLines failed")
    endif()
    voyemu_run_formatter("${voyemu_java_files}" ${voyemu_java_format_command} --replace)
    if(voyemu_failed)
        message(FATAL_ERROR "google-java-format failed")
    endif()
    voyemu_tree_digest(after)
    if(before STREQUAL after)
        message(STATUS "Formatted ${voyemu_count} C/C++ and ${voyemu_java_count} Java files in ${pass} passes")
        return()
    endif()
endforeach()
message(FATAL_ERROR "Formatting did not converge in 8 passes")
