  "compatibility": {
    "blocking_requirements": [
      "Android ADAS/cruise/distance/custom wheel routes remain unsupported; the eight verified public Android routes are partial capability, and actual media track transitions were not verified.",
      "API30 secondary windows enumerate genuine hierarchy; legacy metadata remains partial without ViewDumpBridge.",
      "OEM Music Bluetooth is disconnected; USB/BT content playback is not claimed. Navigation is verified at its original unaccepted terms screen, without consent or external route/content claims.",
      "Automotive STR and Launcher CarService/VHAL power lifecycle remain unsupported; guarded startup gateways preserve the available genuine OEM paths.",
      "Optional AQY video data requires its genuine content provider; the Launcher guard skips observer registration only when that provider is absent.",
      "Generic manifest recipes, all OEM patches, general QG runtime JNI and the full QNX protocol are not globally certified by the bounded runtime matrix.",
      "KeyManager transaction completion proves submission; verified route handlers and volume readback are scoped separately from media playback, cloud recognition and physical vehicle behavior."
    ],
    "generic_manifest_recipe_api": 30,
    "privapp_whitelist": {
      "file": "files/voyemu-privapp.xml",
      "packages": {
        "com.qinggan.app.launcher": [
